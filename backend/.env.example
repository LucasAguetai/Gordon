# Copie ce fichier en .env et ajuste si besoin.
# Les valeurs ci-dessous sont celles par défaut en développement local.

# --- Serveur ---
GORDON_HOST=127.0.0.1
GORDON_PORT=8787
GORDON_FRONTEND_ORIGIN=http://localhost:5173

# --- Sessions ---
# IMPORTANT : génère une vraie valeur pour la production, sinon les sessions
# sont invalidées à chaque redémarrage du serveur.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# GORDON_SECRET_KEY=

# --- Passkey (WebAuthn) ---
GORDON_RP_ID=localhost
GORDON_RP_NAME=Gordon
GORDON_RP_ORIGIN=http://localhost:5173

# Mets à true le temps d'enregistrer ta première passkey, puis repasse à false.
# (Si aucune passkey n'existe encore, l'inscription est ouverte de toute façon.)
GORDON_ALLOW_REGISTRATION=false

# --- Moteur IA ---
GORDON_MODEL=opus

# Le paquet claude-agent-sdk embarque son propre binaire `claude` : il n'y a
# rien à installer séparément. Ne renseigne ceci que pour forcer un autre CLI.
# GORDON_CLI_PATH=/opt/homebrew/bin/claude


# ===========================================================================
# Exemple de configuration pour la production sur gordon.aguetai.fr
# ===========================================================================
# GORDON_HOST=127.0.0.1
# GORDON_PORT=8787
# GORDON_FRONTEND_ORIGIN=https://gordon.aguetai.fr
# GORDON_SECRET_KEY=<valeur générée, gardée secrète>
# GORDON_RP_ID=gordon.aguetai.fr
# GORDON_RP_ORIGIN=https://gordon.aguetai.fr
# GORDON_ALLOW_REGISTRATION=false
